{
  "name": "d-fence",
  "version": "0.1.0",
  "private": true,
  "description": "D-Fence \u00e2\u20ac\u201d dengue sanitisation prioritiser (SC2006/CZ2006)",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev:server": "tsx watch src/server.ts",
    "dev:scheduler": "tsx watch src/scheduler.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "ingest": "tsx src/tools/ingest-once.ts",
    "serve": "tsx src/server.ts",
    "uat": "tsx src/tools/uat.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "express": "^4.19.2",
    "node-cron": "^3.0.3",
    "pg": "^8.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "jsdom": "^25.0.1",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
