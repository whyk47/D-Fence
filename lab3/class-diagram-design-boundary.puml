@startuml D-Fence-DesignBoundary
' D-Fence — Design class model, boundary layer (Lab 3 deliverable 2, part 1c)
' Fox heuristic 1: analysis actors become interface classes. Two kinds of boundary exist here —
' the HTTP surface the browser talks to, and the adapters to the five external services.

skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide circle

package "Boundary — HTTP surface (server)" #FDFDF7 {
  class ExpressApp {
    + mount(router : Router) : void
    + listen(port : number) : void
  }
  abstract class RouteHandler <<boundary>> {
    # ac : AccessControlService
    + handle(req : Request, res : Response) : Promise<void>
    # principalOf(req : Request) : Principal
    # validate(schema : Schema, body : unknown) : object
    # fail(res : Response, error : DomainError) : void
  }
  class AuthRoutes
  class LocationRoutes
  class ReportRoutes
  class ClusterRoutes
  class DashboardRoutes
  class WorkOrderRoutes
  class CrewRoutes
  class AdminRoutes
  RouteHandler <|-- AuthRoutes
  RouteHandler <|-- LocationRoutes
  RouteHandler <|-- ReportRoutes
  RouteHandler <|-- ClusterRoutes
  RouteHandler <|-- DashboardRoutes
  RouteHandler <|-- WorkOrderRoutes
  RouteHandler <|-- CrewRoutes
  RouteHandler <|-- AdminRoutes
  ExpressApp o--> RouteHandler
}

package "Ports — external service interfaces (src/ports)" #F2F7F2 {
  interface ExternalGateway <<interface>> {
    + sourceKind() : SourceKind
    + isHealthy() : Promise<boolean>
  }
  interface ClusterSource <<interface>> {
    + fetchClusters() : Promise<RawPayload>
  }
  interface RainfallSource <<interface>> {
    + fetchStations() : Promise<RawPayload>
    + fetchReadings(since : Date) : Promise<RawPayload>
  }
  interface ForecastSource <<interface>> {
    + fetch24hForecast() : Promise<RawPayload>
  }
  interface GeocodingSource <<interface>> {
    + search(address : string) : Promise<GeoPoint[]>
  }
  interface NotificationChannel <<interface>> {
    + send(chatId : string, text : string) : Promise<DeliveryOutcome>
  }
  interface AuthProvider <<interface>> {
    + register(credentials) : Promise<AuthUserId>
    + signIn(credentials) : Promise<AuthSession>
    + signOut(token) : Promise<void>
    + requestPasswordReset(email) : Promise<void>
    + completePasswordReset(token, password) : Promise<void>
    + verifyToken(token) : Promise<AuthUserId>
    + createUser(credentials) : Promise<AuthUserId>
    + disableUser(id) : Promise<void>
    + deleteUser(id) : Promise<void>
  }
  interface ObjectStorage <<interface>> {
    + upload(bucket, data, contentType) : Promise<StoredObject>
    + signedUrl(bucket, key, ttlSeconds) : Promise<string>
    + remove(bucket, key) : Promise<void>
  }

}

package "Boundary — external gateway adapters (src/boundary/gateways)" #F7FAFD {
  class NEAFeedGateway <<boundary>> {
    - datasetId : string
    + metadataUrl() : string
    + pollDownloadUrl() : string
    + fetchLastUpdatedAt() : Promise<string>
    + fetchClusters() : Promise<RawPayload>
  }
  class RainfallGateway <<boundary>>
  class ForecastGateway <<boundary>>
  class OneMapGateway <<boundary>> {
    - token : string
    - tokenExpiry : Date
    + requestToken() : Promise<void>
    - ensureToken() : Promise<void>
  }
  class TelegramGateway <<boundary>>
  class SupabaseAuthGateway <<boundary>> {
    - serviceKey : string
  }
  class SupabaseStorageGateway <<boundary>> {
    - serviceKey : string
  }
  AuthProvider <|.. SupabaseAuthGateway
  ObjectStorage <|.. SupabaseStorageGateway

  ExternalGateway <|-- ClusterSource
  ExternalGateway <|-- RainfallSource
  ExternalGateway <|-- ForecastSource
  ExternalGateway <|-- GeocodingSource
  ClusterSource <|.. NEAFeedGateway
  RainfallSource <|.. RainfallGateway
  ForecastSource <|.. ForecastGateway
  GeocodingSource <|.. OneMapGateway
  NotificationChannel <|.. TelegramGateway

  class HttpClient <<infrastructure>> {
    + get(url : string, opts : RequestOptions) : Promise<Response>
    + post(url : string, body : unknown) : Promise<Response>
    - withRetry(fn : Thunk, attempts : number) : Promise<Response>
    - withRateLimit(key : string) : Promise<void>
  }
  NEAFeedGateway --> HttpClient
  RainfallGateway --> HttpClient
  ForecastGateway --> HttpClient
  OneMapGateway --> HttpClient
  TelegramGateway --> HttpClient
}

package "Boundary — web client (React)" #FDFDF7 {
  class AppShell {
    + role : Role
    + navigationFor(role : Role) : NavItem[]
  }
  class RouteGuard {
    + require(role : Role) : Element
  }
  class ApiClient {
    + get(path : string) : Promise<T>
    + post(path : string, body : unknown) : Promise<T>
    - onUnauthorised() : void
  }
  class ScreenComponent <<boundary>> {
    + state : LoadState
    + render() : Element
  }
  note right of ScreenComponent
    27 screens (REQUIREMENTS.md 11.2), one component each,
    in client/src/screens grouped by role. Every one carries
    the four §11.4 sub-states — loading, empty, error, stale
    — as a single LoadState value rather than four booleans,
    so an impossible combination cannot be represented.
  end note
  AppShell o--> ScreenComponent
  AppShell *-- RouteGuard
  ScreenComponent --> ApiClient
}

note top of ExternalGateway
  **Adapter, with the interfaces held in a separate ports
  package.** Each gateway converts one external protocol into
  the interface the control layer expects — and because the
  interface lives in src/ports, the dependency runs
  control -> ports and boundary -> ports, with no arrow from
  control into boundary. An adversarial review found that the
  first version put these interfaces in boundary/, which made
  the stated dependency rule false.
  Three things follow: 10.4.6 rate limiting and retry live in
  one place (HttpClient); a control class can be unit-tested
  against a fake port, which 10.6.3 requires; and the two
  one source still unverified — OneMap Search — is isolated
  behind one adapter. The NEA feed was characterised on
  2026-09-03: it revises twice a week, so NEAFeedGateway now
  exposes fetchLastUpdatedAt() and the hourly cycle of 1.1.1
  downloads only when that stamp moves (1.1.20).
end note

note bottom of SupabaseAuthGateway
  Decided 2026-09-03: Supabase Auth rather than
  hand-rolled credentials. The port exists anyway,
  because the split is not clean — 2.1.2, 2.1.3, the
  2.1.10 lock-out and the 2.2.1 role stay in
  AuthenticationController. See DESIGN-MODEL.md §3.3.
  The service key bypasses row-level security and is
  server-side only; the browser gets the anon key.
end note

note bottom of RouteHandler
  Every handler calls AccessControlService.authorise()
  before touching a control class. 2.3.6 and 10.3.3 require
  enforcement on the server, and putting the call in the
  abstract base is how the design makes forgetting it
  visible rather than silent.
end note

@enduml
